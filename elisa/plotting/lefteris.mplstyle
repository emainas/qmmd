# rotskoff.mplstyle
# Matplotlib style reproducing the figure aesthetic of
# "Lectures on Statistical Mechanics" (G. M. Rotskoff).
#
# Use with:   plt.style.use("rotskoff.mplstyle")
# Colours and Computer-Modern math match the LaTeX template (et-book + CM math).
# Tick labels are serif; if you have the CMU/Latin-Modern fonts installed they
# will be picked up automatically, otherwise DejaVu Serif is the fallback.

# ---- fonts ---------------------------------------------------------------
font.family        : serif
font.serif         : CMU Serif, Latin Modern Roman, DejaVu Serif
mathtext.fontset   : cm
# For a pixel-perfect match to the PDF (requires a working TeX install), set:
# text.usetex      : True

# ---- figure --------------------------------------------------------------
figure.figsize     : 6.0, 4.2
figure.dpi         : 120
savefig.dpi        : 300
savefig.bbox       : tight
savefig.transparent: False
figure.facecolor   : white
axes.facecolor     : white

# ---- the box / spines ----------------------------------------------------
# All four spines visible (a closed box), as in the notes.
axes.spines.top    : True
axes.spines.right  : True
axes.spines.left   : True
axes.spines.bottom : True
axes.linewidth     : 1.1
axes.edgecolor     : black

# ---- ticks: short, outward, both labelled axes ---------------------------
xtick.direction    : out
ytick.direction    : out
xtick.major.size   : 5.0
ytick.major.size   : 5.0
xtick.major.width  : 1.1
ytick.major.width  : 1.1
xtick.top          : False
ytick.right        : False
xtick.labelsize    : 13
ytick.labelsize    : 13

# ---- labels / titles -----------------------------------------------------
axes.labelsize     : 16
axes.titlesize     : 16
axes.labelcolor    : black
axes.titlepad      : 8.0

# ---- lines ---------------------------------------------------------------
lines.linewidth    : 2.2
lines.solid_capstyle : round
lines.dash_capstyle  : round

# ---- legend: no frame ----------------------------------------------------
legend.frameon     : False
legend.fontsize    : 14
legend.handlelength: 2.2
legend.borderaxespad : 0.6

# ---- no grid -------------------------------------------------------------
axes.grid          : False

# ---- the house colour cycle ---------------------------------------------
# navy, orange-red, teal, sky-cyan, gold  (measured from the PDF).
axes.prop_cycle : cycler('color', ['1F3A5F', 'D8481A', '2E9E7E', '1C9BD1', 'C9B23B'])
