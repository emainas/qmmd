# block 1: autoimage
parm /nas/longleaf/home/emainas/software/dcdftbmd.2.0/molecules/MEA/qmmd/systems/MEA/solv_5.0/prep/solv.parm7
trajin ../equil-npt.nc
autoimage
trajout production.autoimaged.nc netcdf
run 

# block 2: extract last frame with same topology
clear trajin
trajin production.autoimaged.nc lastframe
trajout last_autoimaged.rst7 rst7
run

# block 3: strip ion and make topology and xyz
clear trajin
trajin last_autoimaged.rst7
strip :Cl-
trajout last_no_ion.rst7 rst7
run

# block 4: strip ion from the topology file
clear parm
clear trajin
parm ../../prep/solv.parm7
parmstrip :Cl-
parmwrite out no_ion.parm7
run

# block 4: find furthest water and strip one of its two hydrogens (does not matter which one)
clear trajin
clear parm
parm no_ion.parm7
trajin last_no_ion.rst7
closest 999999 :1 first closestout closest_waters.dat
run
quit
